# Frontend URL for the local API. This value is public and contains no credentials.
VITE_API_BASE_URL=http://127.0.0.1:3001

# Backend-only configuration. Replace these with PayPal sandbox app credentials.
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Backend-only Google Gemini API key. Obtain one at https://aistudio.google.com/apikey
AI_API_KEY=your_gemini_api_key_here
AI_MAX_FALLBACK_MODELS=2
